{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atak Viewer",
  "version": "0.2.0",
  "identifier": "com.yavuzyazici.movviewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Atak Viewer",
        "width": 1120,
        "height": 700,
        "minWidth": 560,
        "minHeight": 380,
        "center": true,
        "decorations": false,
        "theme": "Dark",
        "backgroundColor": "#09090b",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob: asset: http://asset.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/atak-ffmpeg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["mov"],
        "name": "QuickTime Movie",
        "description": "QuickTime film dosyası",
        "mimeType": "video/quicktime",
        "role": "Viewer"
      }
    ]
  }
}
